+/**
+ * A whole-word, case-insensitive pattern for any of these names, with hyphens and spaces optional
+ * between their parts: "H-1B" matches "H1B", "h-1b" and "H 1B", but not "H-1B1" or "BH1B". Null when no name is given.
+ */
+export function visaNamePattern(names: readonly string[]): RegExp | null {
+  const parts = names
+    .map((n) => n.trim().toLowerCase())
+    .filter(Boolean)
+    .map((n) =>
+      n
+        .split(/[-\s]+/)
+        .filter(Boolean)
+        // Within a part, a hyphen or space may also come where letters meet digits: "h1b" is "h-1-b".
+        .map((t) => t.split(/(?<=[a-z])(?=\d)|(?<=\d)(?=[a-z])/).map((x) => x.replace(/[.*+?^${}()|[\]\\/]/g, "\\$&")).join("[-\\s]?"))
+        .join("[-\\s]*"),
+    )
+    .filter(Boolean);
+  return parts.length ? new RegExp(`(?<![a-z0-9])(?:${parts.join("|")})(?![a-z0-9])`, "i") : null;
+}
+
+/**
+ * The visa rules the profile sets, or null when it names no visa type. `own` matches the
+ * candidate's own type or any of its names; `never` matches a type never given as theirs.
+ */
+export function visaRules(profile: Pick<Profile, "workAuthorization">): { type: string; names: string[]; never: string[] } | null {
+  const w = profile.workAuthorization;
+  const type = w.visaType?.trim();
+  if (!type) return null;
+  return { type, names: (w.visaTypeNames ?? []).map((n) => n.trim()).filter(Boolean), never: (w.neverVisaTypes ?? []).map((n) => n.trim()).filter(Boolean) };
+}
+
+/**
+ * The lines that tell a writer about the visa type, empty when the profile names none. `leave` is
+ * what to do with a field no option of which names the type.
+ */
+export function visaLines(profile: Pick<Profile, "workAuthorization">, leave: string): string[] {
+  const v = visaRules(profile);
+  if (!v) return [];
+  const later = sponsorshipLater(profile);
+  const names = [v.type, ...v.names.filter((n) => n.toLowerCase() !== v.type.toLowerCase())];
+  return [
+    ...(later.length ? [`In ${later.join(", ")} the candidate is currently authorized to work, through ${v.type}, so a question whether they are currently authorized to work there is Yes.`] : []),
+    `The visa type is ${v.type}.${v.never.length ? ` Never choose or write ${v.never.join(" or ")} as the type.` : ""} If no option names ${names.join(" or ")}, ${leave}.`,
+  ];
+}
