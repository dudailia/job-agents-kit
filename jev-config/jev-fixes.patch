+  if ((e.fit?.score ?? 0) < floor) return `its fit score is under ${floor}`;
   const tier = e.fit?.locationTier;
   if (p.where.length && !(tier && (p.where as string[]).includes(tier))) return `it is not in ${p.where.join(", ")}`;
   const level = (e.fit?.answers.level as { choice?: string } | undefined)?.choice;
   if (p.levels.length && !(level && (p.levels as string[]).includes(level))) return `it is not ${p.levels.join(" or ")}`;
   return null;
 }
+
+/** A policy sent by a page that has no box for the focus block keeps the block the file already holds. */
+export function keepFocus(sent: unknown, kept: Focus): unknown {
+  return sent && typeof sent === "object" && !("focus" in sent) ? { ...sent, focus: kept } : sent;
+}
diff --git a/tests/focusOrder.test.ts b/tests/focusOrder.test.ts
new file mode 100644
index 0000000..7bf38f1
--- /dev/null
+++ b/tests/focusOrder.test.ts
@@ -0,0 +1,127 @@
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { Focus, inFocus, loadFocus, NO_FOCUS, placeRank, seasonRank } from "../src/jobs/focus.js";
+import { sortEntries, type QueueEntry } from "../src/jobs/queue.js";
+import { keepFocus, Policy, policyRefuses } from "../src/run/policy.js";
+
+const job = (title: string, score: number, over: { terms?: string[]; locations?: string[]; postedAt?: string } = {}): QueueEntry =>
+  ({
+    job: { id: `${title}|${score}|${over.postedAt ?? ""}|${(over.locations ?? []).join()}`, title, company: "Example Corp", url: "https://jobs.example.com/1", ats: "greenhouse", terms: over.terms ?? [], locations: over.locations ?? ["Springfield"], postedAt: over.postedAt ?? "2026-11-01" },
+    fit: { score, locationTier: "us", answers: {} },
+  }) as unknown as QueueEntry;
+
+const focus = Focus.parse({
+  titles: ["machine learning", "data scien"],
+  seasonFirst: ["fall", "off-?cycle"],
+  seasonLast: ["summer"],
+  placesFirst: ["new york"],
+  placesThen: ["remote"],
+  minScore: 0.3,
+});
+
+describe("with no focus", () => {
+  it("orders by score, then the most recent posting, as before", () => {
+    const entries = [
+      job("Software Engineer Intern", 0.6, { postedAt: "2026-10-01" }),
+      job("Machine Learning Intern", 0.4, { terms: ["Fall 2026"], locations: ["New York, NY"] }),
+      job("Backend Intern", 0.6, { postedAt: "2026-11-02" }),
+      job("Data Science Intern", 0.9, { terms: ["Summer 2026"] }),
+    ];
+    const titles = (f: Focus) => sortEntries(entries, f).map((e) => e.job.title);
+    expect(titles(NO_FOCUS)).toEqual(["Data Science Intern", "Backend Intern", "Software Engineer Intern", "Machine Learning Intern"]);
+    expect(titles(Focus.parse({}))).toEqual(titles(NO_FOCUS));
+  });
+
+  it("ranks every job the same and puts nothing in focus", () => {
+    const e = job("Machine Learning Intern", 0.5, { terms: ["Summer"], locations: ["New York, NY"] });
+    expect(inFocus(e, NO_FOCUS)).toBe(false);
+    expect(seasonRank(e, NO_FOCUS)).toBe(1);
+    expect(placeRank(e, NO_FOCUS)).toBe(2);
+  });
+
+  it("keeps the policy's own floor", () => {
+    const p = Policy.parse({ minScore: 0.5 });
+    expect(p.focus).toEqual(NO_FOCUS);
+    expect(policyRefuses(job("Machine Learning Intern", 0.4, { terms: ["Fall 2026"] }), p)).toMatch(/under 0.5/);
+    expect(policyRefuses(job("Machine Learning Intern", 0.5), p)).toBeNull();
+  });
+});
+
+describe("with a focus block", () => {
+  it("matches titles, seasons and places at a word start, without regard to case", () => {
+    expect(inFocus(job("Senior MACHINE LEARNING Intern", 0.5), focus)).toBe(true);
+    expect(inFocus(job("Data Scientist Intern", 0.5), focus)).toBe(true);
+    expect(inFocus(job("Metadata Science Intern", 0.5), focus)).toBe(false);
+    expect(seasonRank(job("Intern", 0.5, { terms: ["Off-cycle 2026"] }), focus)).toBe(0);
+    expect(seasonRank(job("Fall Intern", 0.5), focus)).toBe(0);
+    expect(seasonRank(job("Intern", 0.5, { terms: ["Summer 2026"] }), focus)).toBe(2);
+    expect(seasonRank(job("Intern", 0.5), focus)).toBe(1);
+    expect(placeRank(job("Intern", 0.5, { locations: ["New York, NY"] }), focus)).toBe(0);
+    expect(placeRank(job("Intern", 0.5, { locations: ["Remote"] }), focus)).toBe(1);
+    expect(placeRank(job("Intern", 0.5, { locations: ["Springfield"] }), focus)).toBe(2);
+  });
+
+  it("orders by season, then focus titles, then place, then score, then recency", () => {
+    const sorted = sortEntries(
+      [
+        job("Software Engineer Intern", 0.9, { terms: ["Summer 2026"], locations: ["New York, NY"] }),
+        job("Software Engineer Intern", 0.8, { locations: ["Springfield"] }),
+        job("Software Engineer Intern", 0.5, { locations: ["New York, NY"] }),
+        job("Machine Learning Intern", 0.4, { locations: ["Springfield"] }),
+        job("Machine Learning Intern", 0.4, { locations: ["Remote"], postedAt: "2026-10-01" }),
+        job("Machine Learning Intern", 0.4, { locations: ["Remote"], postedAt: "2026-11-05" }),
+        job("Software Engineer Intern", 0.3, { terms: ["Fall 2026"] }),
+      ],
+      focus,
+    );
+    expect(sorted.map((e) => `${e.job.title} ${e.fit?.score} ${e.job.locations[0]} ${e.job.postedAt}`)).toEqual([
+      "Software Engineer Intern 0.3 Springfield 2026-11-01",
+      "Machine Learning Intern 0.4 Remote 2026-11-05",
+      "Machine Learning Intern 0.4 Remote 2026-10-01",
+      "Machine Learning Intern 0.4 Springfield 2026-11-01",
+      "Software Engineer Intern 0.5 New York, NY 2026-11-01",
+      "Software Engineer Intern 0.8 Springfield 2026-11-01",
+      "Software Engineer Intern 0.9 New York, NY 2026-11-01",
+    ]);
+  });
+
+  it("lowers the floor for a role in focus or a first season, and only down", () => {
+    const p = Policy.parse({ minScore: 0.5, focus });
+    expect(policyRefuses(job("Machine Learning Intern", 0.35), p)).toBeNull();
+    expect(policyRefuses(job("Software Engineer Intern", 0.35, { terms: ["Fall 2026"] }), p)).toBeNull();
+    expect(policyRefuses(job("Machine Learning Intern", 0.2), p)).toMatch(/under 0.3/);
+    expect(policyRefuses(job("Software Engineer Intern", 0.45, { terms: ["Summer 2026"] }), p)).toMatch(/under 0.5/);
+    const higher = Policy.parse({ minScore: 0.2, focus: { ...focus, minScore: 0.6 } });
+    expect(policyRefuses(job("Machine Learning Intern", 0.3), higher)).toBeNull();
+  });
+
+  it("is refused in a policy when a pattern does not compile", () => {
+    expect(Policy.safeParse({ focus: { titles: ["(unclosed"] } }).success).toBe(false);
+  });
+});
+
+describe("the focus in the policy file", () => {
+  it("is read from the file, and a missing or broken file gives no focus", () => {
+    const dir = mkdtempSync(path.join(os.tmpdir(), "jev-focus-"));
+    try {
+      const file = path.join(dir, "policy.json");
+      expect(loadFocus(file)).toEqual(NO_FOCUS);
+      writeFileSync(file, JSON.stringify({ version: 1, focus: { titles: ["machine learning"], placesFirst: ["new york"] } }));
+      expect(loadFocus(file)).toMatchObject({ titles: ["machine learning"], placesFirst: ["new york"], minScore: null });
+      const other = path.join(dir, "broken.json");
+      writeFileSync(other, "{ not json");
+      expect(loadFocus(other)).toEqual(NO_FOCUS);
+      writeFileSync(other, JSON.stringify({ focus: { titles: "machine learning" } }));
+      expect(loadFocus(other)).toEqual(NO_FOCUS);
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it("is kept when a page that has no box for it saves the policy", () => {
+    expect(keepFocus({ target: 5 }, focus)).toEqual({ target: 5, focus });
+    expect(keepFocus({ target: 5, focus: NO_FOCUS }, focus)).toEqual({ target: 5, focus: NO_FOCUS });
+  });
+});
diff --git a/tests/visaType.test.ts b/tests/visaType.test.ts
new file mode 100644
index 0000000..2838d32
--- /dev/null
+++ b/tests/visaType.test.ts
@@ -0,0 +1,90 @@
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { ProfileSchema, visaNamePattern, type Profile } from "../src/profile/schema.js";
+import { buildFormState, gateAnswer, planField } from "../src/forms/mapForm.js";
+import { buildSystem, candidateContext, contextFingerprint } from "../src/answers/resolve.js";
+import type { DumpedField, FieldsDump } from "../src/forms/fields.js";
+import type { Job } from "../src/jobs/normalize.js";
+
+const example = ProfileSchema.parse(JSON.parse(readFileSync(new URL("../data/profile.example.json", import.meta.url), "utf8")));
+const withVisa = (over: Partial<Profile["workAuthorization"]>): Profile => ({ ...example, workAuthorization: { ...example.workAuthorization, ...over } });
+/** Authorized in Canada, and in the US now on F-1 CPT, needing sponsorship later; never H-1B as the type. */
+const student = withVisa({ authorizedWithSponsorshipLater: ["United States"], visaType: "F-1 CPT", visaTypeNames: ["F-1", "CPT"], neverVisaTypes: ["H-1B"] });
+
+const job = { id: "j", source: "t", company: "Example Corp", title: "Software Engineer Intern", url: "https://jobs.example.com/1", ats: "greenhouse", locations: ["New York, NY"], postedAt: null, terms: [], sponsorship: "unknown", degrees: [], category: null } as Job;
+const field = (over: Partial<DumpedField>): DumpedField => ({ id: "f0", widget: "", selector: "#x", kind: "text", name: "", label: "", hint: "", placeholder: "", required: true, value: "", options: [], accept: "", maxLength: null, autocomplete: "", buttonGroup: false, section: "", ...over });
+const visaQ = field({ kind: "radio", label: "Which visa type do you hold?" });
+const dump = { url: "https://jobs.example.com/1/apply", title: "Apply", context: "", fields: [] } as unknown as FieldsDump;
+
+describe("visa names", () => {
+  it("match as whole words, with or without hyphens and spaces", () => {
+    const re = visaNamePattern(["H-1B"]);
+    for (const v of ["H1B", "h-1b", "H 1B", "an H-1B visa"]) expect(re?.test(v), v).toBe(true);
+    for (const v of ["H-1B1", "BH1B", "H-2B"]) expect(re?.test(v), v).toBe(false);
+    expect(visaNamePattern(["F-1 CPT"])?.test("F1 CPT")).toBe(true);
+    expect(visaNamePattern(["CPT"])?.test("acceptable")).toBe(false);
+    expect(visaNamePattern([])).toBeNull();
+    expect(visaNamePattern(["  "])).toBeNull();
+  });
+});
+
+describe("the visa type gate", () => {
+  it("refuses a type the profile never gives, unless the answer names the candidate's own", () => {
+    for (const v of ["H1B", "H-1B", "H-1B visa"]) expect(gateAnswer(visaQ, v, student, job), v).toMatch(/never gives/);
+    expect(gateAnswer(visaQ, "F1", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "CPT", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "F-1 CPT, then H-1B later", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "TN", student, job)).toBeNull();
+  });
+
+  it("leaves a plain Yes or No to the right-to-work gate", () => {
+    const sponsorQ = field({ kind: "radio", label: "Will you now or in the future require H-1B sponsorship?" });
+    expect(gateAnswer(sponsorQ, "Yes, H-1B", student, job)).toBeNull();
+    expect(gateAnswer(sponsorQ, "No", student, job)).toMatch(/does not match the profile/);
+  });
+
+  it("holds a picked option that names a forbidden type for the candidate", () => {
+    const options = [{ value: "a", label: "H-1B" }, { value: "b", label: "F-1 (CPT/OPT)" }];
+    const f = field({ kind: "select", label: "Which visa type do you hold?", options });
+    const pick = (choice: string) => ({ type: "choice", choice, confidence: 0.99, probabilities: {} }) as never;
+    expect(planField(f, pick("o0"), student, job)).toMatchObject({ action: "review", note: expect.stringMatching(/never gives/) });
+    expect(planField(f, pick("o1"), student, job).value).toBe("b");
+  });
+
+  it("refuses nothing new when the profile names no type", () => {
+    for (const v of ["H1B", "H-1B visa", "F1"]) expect(gateAnswer(visaQ, v, example, job), v).toBeNull();
+  });
+});
+
+describe("the writer's visa lines", () => {
+  const rulesOf = (p: Profile) => (buildFormState(p, job, dump, []).candidate as { rules: string[] }).rules;
+
+  it("are in the form state and the writer's context only when a visa type is set", () => {
+    expect(rulesOf(example).join(" ")).not.toMatch(/visa type/i);
+    expect(candidateContext(example)).not.toHaveProperty("visa_rules");
+    expect(buildSystem(example)).not.toMatch(/visa_rules/);
+
+    const rules = rulesOf(student).join("\n");
+    expect(rules).toMatch(/In United States the candidate is currently authorized to work, through F-1 CPT, so a question whether they are currently authorized to work there is Yes/);
+    expect(rules).toMatch(/The visa type is F-1 CPT\. Never choose or write H-1B as the type\. If no option names F-1 CPT or F-1 or CPT, leave the field for the candidate/);
+    const visa = candidateContext(student).visa_rules as string[];
+    expect(visa.join("\n")).toMatch(/currently authorized to work, through F-1 CPT/);
+    expect(visa.join("\n")).toMatch(/set verdict to "needs_review"/);
+  });
+
+  it("leave the writer's context as before when the visa fields are empty", () => {
+    const blank = withVisa({ visaType: "", visaTypeNames: [], neverVisaTypes: [] });
+    expect(candidateContext(blank)).not.toHaveProperty("visa_rules");
+    expect(rulesOf(blank)).toEqual(rulesOf(example));
+    const { visaType: _a, visaTypeNames: _b, neverVisaTypes: _c, ...older } = example.workAuthorization;
+    const before = { ...example, workAuthorization: older };
+    expect(rulesOf(before)).toEqual(rulesOf(example));
+    expect(contextFingerprint(before)).not.toBe(contextFingerprint(student));
+  });
+
+  it("say nothing about current authorization without a country that needs sponsorship later", () => {
+    const rules = rulesOf(withVisa({ visaType: "TN" })).join("\n");
+    expect(rules).toMatch(/The visa type is TN\. If no option names TN, leave the field/);
+    expect(rules).not.toMatch(/currently authorized/);
+  });
+});
