+/**
+ * Which queued jobs come first: the `focus` block of data/policy.json. The titles the person
+ * wants first, the seasons that go first and last, the places that go first and next, and a
+ * lower fit floor for a role in focus. Every list is empty by default, and then the queue is
+ * ordered by score and recency alone and the floor is the policy's own.
+ *
+ * This lives apart from the policy so the queue can read it without importing the policy,
+ * which imports the queue.
+ */
+import { existsSync, readFileSync, statSync } from "node:fs";
+import { z } from "zod";
+import { PATHS } from "../config.js";
+import type { QueueEntry } from "./queue.js";
+
+const compiles = (s: string): boolean => {
+  try {
+    new RegExp(s, "i");
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+/** Case-insensitive regular expression fragments, each matched at the start of a word. */
+const Fragments = z.array(z.string().min(1).refine(compiles, { message: "not a valid regular expression" })).default([]);
+
+export const Focus = z.object({
+  /** Titles of the roles wanted first ("machine learning", "data scien"). */
+  titles: Fragments,
+  /** Seasons that go first, tried on the title and the terms ("winter", "co-?op"). */
+  seasonFirst: Fragments,
+  /** Seasons that go last ("summer"). A job that names neither goes between. */
+  seasonLast: Fragments,
+  /** Places that go first, tried on the locations ("new york"). */
+  placesFirst: Fragments,
+  /** Places that go next, before everywhere else. */
+  placesThen: Fragments,
+  /** The fit floor for a role in focus or a first-season role, when lower than the policy's `minScore`. Null keeps that floor for every job. */
+  minScore: z.number().min(0).max(1).nullable().default(null),
+});
+export type Focus = z.infer<typeof Focus>;
+
+/** No focus: the order and floor are the plain ones. */
+export const NO_FOCUS: Focus = Focus.parse({});
+
+let cached: { file: string; mtimeMs: number; focus: Focus } | null = null;
+
+/**
+ * The focus block of the policy file. A missing file, a file that is not valid JSON, or a focus
+ * block that is not valid all give no focus: the order of the queue is never an error. Read once
+ * per change of the file.
+ */
+export function loadFocus(file = PATHS.policy): Focus {
+  try {
+    if (!existsSync(file)) return NO_FOCUS;
+    const mtimeMs = statSync(file).mtimeMs;
+    if (cached && cached.file === file && cached.mtimeMs === mtimeMs) return cached.focus;
+    const raw = (JSON.parse(readFileSync(file, "utf8")) as { focus?: unknown } | null)?.focus;
+    const parsed = Focus.safeParse(raw ?? {});
+    const focus = parsed.success ? parsed.data : NO_FOCUS;
+    cached = { file, mtimeMs, focus };
+    return focus;
+  } catch {
+    return NO_FOCUS;
+  }
+}
+
+const patterns = new WeakMap<readonly string[], RegExp | null>();
+/** One pattern for a list of fragments, each at a word start. Null for an empty list, which matches nothing. */
+function anyOf(words: readonly string[]): RegExp | null {
+  if (patterns.has(words)) return patterns.get(words) ?? null;
+  const re = words.length ? new RegExp(`\\b(?:${words.join("|")})`, "i") : null;
+  patterns.set(words, re);
+  return re;
+}
+const said = (words: readonly string[], text: string): boolean => anyOf(words)?.test(text) ?? false;
+
+type Entry = Pick<QueueEntry, "job">;
+
+/** True when the title is one of the person's focus titles. */
+export const inFocus = (e: Entry, f: Focus = loadFocus()): boolean => said(f.titles, e.job.title);
+
+/** 0 for a job in a first season, 2 for one in a last season, 1 for any other. With no seasons set, every job is 1. */
+export function seasonRank(e: Entry, f: Focus = loadFocus()): 0 | 1 | 2 {
+  const text = `${e.job.title} ${(e.job.terms ?? []).join(" ")}`;
+  if (said(f.seasonFirst, text)) return 0;
+  return said(f.seasonLast, text) ? 2 : 1;
+}
+
+/** 0 for a job in a first place, 1 for one in a next place, 2 for anywhere else. With no places set, every job is 2. */
+export function placeRank(e: Entry, f: Focus = loadFocus()): 0 | 1 | 2 {
+  const text = (e.job.locations ?? []).join(" ; ");
+  if (said(f.placesFirst, text)) return 0;
+  return said(f.placesThen, text) ? 1 : 2;
+}
