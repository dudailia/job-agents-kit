<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.USERNAME.jobkit-research</string>
<key>ProgramArguments</key><array><string>/bin/zsh</string><string>/Users/USERNAME/job-agents-kit/launchd/run-research.sh</string></array>
<key>WorkingDirectory</key><string>/Users/USERNAME/job-agents-kit</string>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>40</integer></dict>
<key>RunAtLoad</key><false/>
<key>ProcessType</key><string>Background</string>
<key>LowPriorityIO</key><true/>
<key>Nice</key><integer>19</integer>
<key>StandardOutPath</key><string>/Users/USERNAME/job-agents-kit/logs/research.out</string>
<key>StandardErrorPath</key><string>/Users/USERNAME/job-agents-kit/logs/research.out</string>
</dict></plist>
