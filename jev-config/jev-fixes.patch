+    expect(sent.sort()).toEqual([...IDS].sort());
+    expect(submitJob).toHaveBeenCalledTimes(2);
+    for (const id of IDS) expect(entry(id).status).toBe("applied");
+  });
+
+  it("a run told to send (daily --send) sends whatever the policy's mode, and one told to prepare never sends", async () => {
+    const { sent } = await pipeline(takeJobs([IDS[0] as string], { count: 1, dry: false }), { submit: true, dry: false, prepare: false, fresh: false, quiet: true });
+    expect(sent).toEqual([IDS[0]]);
+    writePolicy({ mode: "send" });
+    const held = await pipeline(takeJobs([IDS[1] as string], { count: 1, dry: false }), { submit: true, dry: false, prepare: true, fresh: false, quiet: true });
+    expect(held.sent).toEqual([]);
+    expect(submitJob).toHaveBeenCalledTimes(1);
+    expectPrepared([IDS[1] as string]);
+  });
+});
+
+describe("a form waiting for approval", () => {
+  it("is kept open for RUN.approvalExpiryHours, then closed and put on the by-hand list", async () => {
+    await pipeline(takeJobs([], { count: 2, dry: false }), { submit: true, dry: false, fresh: false, quiet: true });
+    const hoursAgo = (h: number) => new Date(Date.now() - h * 60 * 60_000).toISOString();
+    const s = loadSession();
+    const [fresh, stale] = IDS as [string, string];
+    const tab = (id: string) => s[id] as NonNullable<(typeof s)[string]>;
+    saveSession({ ...s, [fresh]: { ...tab(fresh), since: hoursAgo(20) }, [stale]: { ...tab(stale), since: hoursAgo(31) } });
+    await sweep();
+    // 20 hours is past the 12 a sign-in is kept, and within the 30 an approval is.
+    expect(entry(fresh)).toMatchObject({ status: "awaiting_user_action", waitingFor: "approval" });
+    expect(entry(stale).status).toBe("needs_review");
+    expect(entry(stale).statusReason).toMatch(/left open too long/);
+    expect(vi.mocked(closeJobTab)).toHaveBeenCalledWith(stale);
+  });
+});
diff --git a/tests/prepareDaily.test.ts b/tests/prepareDaily.test.ts
new file mode 100644
index 0000000..80edad8
--- /dev/null
+++ b/tests/prepareDaily.test.ts
@@ -0,0 +1,151 @@
+import { mkdtempSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { DAILY } from "../src/config.js";
+import type { QueueEntry } from "../src/jobs/queue.js";
+import { dailyRun, formatDaily, isPrepared, resultLine, type DailyDeps, type Outcome } from "../src/run/daily.js";
+import { keepMode, Policy } from "../src/run/policy.js";
+
+const START = new Date(2026, 9, 5, 9, 0, 0);
+
+function job(id: string, over: { ats?: string; company?: string; status?: QueueEntry["status"]; waitingFor?: QueueEntry["waitingFor"] } = {}): QueueEntry {
+  return {
+    job: { id, source: "test", company: over.company ?? `Company ${id}`, title: "Software Intern", url: `https://jobs.example.com/${id}`, ats: over.ats ?? "greenhouse", locations: ["Springfield"], postedAt: "2026-10-01", terms: [], sponsorship: "unknown", degrees: [], category: null },
+    fit: { score: 0.8, decision: "apply", skipReason: null, reasons: [], components: {}, locationTier: "us", answers: { level: { type: "choice", choice: "internship", probabilities: {}, confidence: 1 } } },
+    preFilterReason: null,
+    status: over.status ?? "queued",
+    statusReason: null,
+    waitingFor: over.waitingFor ?? null,
+    answers: [],
+    replies: [],
+    response: null,
+    attempts: 0,
+    discoveredAt: START.toISOString(),
+    updatedAt: START.toISOString(),
+    appliedAt: null,
+    notes: "",
+  } as unknown as QueueEntry;
+}
+
+/** A queue and a clock, and a run that does what the pipeline does: prepares when told to, else sends. */
+function world(entries: QueueEntry[]) {
+  let now = START.getTime();
+  const slept: number[] = [];
+  const ran: { id: string; prepare: boolean | undefined }[] = [];
+  const deps: DailyDeps = {
+    now: () => new Date(now),
+    sleep: async (ms) => {
+      slept.push(ms);
+      now += ms;
+    },
+    random: () => 0.5,
+    queue: () => entries,
+    run: async (id, o) => {
+      const e = entries.find((x) => x.job.id === id) as QueueEntry;
+      ran.push({ id, prepare: o?.prepare });
+      const out: Outcome = o?.prepare
+        ? { status: "awaiting_user_action", waitingFor: "approval", reason: "filled and checked, not sent", ready: true, report: null }
+        : { status: "applied", waitingFor: null, reason: null, ready: true, report: null };
+      e.status = out.status;
+      e.waitingFor = out.waitingFor;
+      e.updatedAt = new Date(now).toISOString();
+      if (out.status === "applied") e.appliedAt = new Date(now).toISOString();
+      now += 30_000;
+      return out;
+    },
+    gate: () => () => null,
+    jevSpentToday: () => 0,
+    log: () => undefined,
+    pausesFile: path.join(mkdtempSync(path.join(tmpdir(), "jev-prepare-daily-")), "pauses.json"),
+  };
+  return { deps, slept, ran };
+}
+
+describe("the policy's mode", () => {
+  it("is prepare unless the policy says send", () => {
+    expect(Policy.parse({}).mode).toBe("prepare");
+    expect(Policy.parse({ mode: "send" }).mode).toBe("send");
+    expect(Policy.safeParse({ mode: "sometimes" }).success).toBe(false);
+    const example = Policy.parse(JSON.parse(readFileSync(path.join(__dirname, "..", "data", "policy.example.json"), "utf8")));
+    expect(example.mode).toBe("prepare");
+  });
+
+  it("is kept from the file when the dashboard, which has no box for it, saves the policy", () => {
+    expect(keepMode({ target: 5 }, "prepare")).toEqual({ target: 5, mode: "prepare" });
+    expect(keepMode({ target: 5 }, "send")).toEqual({ target: 5, mode: "send" });
+    // A page that sends its own mode is taken as it is.
+    expect(keepMode({ target: 5, mode: "prepare" }, "send")).toEqual({ target: 5, mode: "prepare" });
+    expect(Policy.parse(keepMode({ target: 5 }, "send"))).toMatchObject({ target: 5, mode: "send" });
+  });
+});
+
+describe("the daily run in prepare mode, the default", () => {
+  it("prepares the day's number, sends nothing and waits for no board", async () => {
+    const entries = [job("a"), job("b"), job("c")];
+    const w = world(entries);
+    const s = await dailyRun(Policy.parse({}), { dry: false, target: 2 }, w.deps);
+    expect(w.ran).toEqual([
+      { id: "a", prepare: true },
+      { id: "b", prepare: true },
+    ]);
+    expect(s.sent).toEqual([]);
+    expect(s.prepare).toBe(true);
+    expect(s.prepared?.map((l) => l.id)).toEqual(["a", "b"]);
+    expect(w.slept).toEqual([]);
+    expect(entries.filter(isPrepared).map((e) => e.job.id)).toEqual(["a", "b"]);
+    expect(entries.some((e) => e.status === "applied")).toBe(false);
+    expect(s.stoppedBecause).toMatch(/2 applications are done/);
+    expect(resultLine(s)).toBe("2 ready for your approval, nothing sent. 0 need you. 0 could not be prepared.");
+    const text = formatDaily(s);
+    expect(text).toMatch(/Prepared, nothing sent\./);
+    expect(text).toMatch(/Ready for your approval \(2\)\. .*npx jev submit <id>/);
+    expect(text).toMatch(/\n {4}a {2}Company a \| Software Intern/);
+  });
+
+  it("counts forms still waiting from earlier runs, and leaves at most DAILY.maxAwaitingApproval open", async () => {
+    const waiting = Array.from({ length: DAILY.maxAwaitingApproval - 1 }, (_, i) => job(`w${i}`, { status: "awaiting_user_action", waitingFor: "approval" }));
+    const entries = [...waiting, job("a"), job("b", { ats: "lever" })];
+    const w = world(entries);
+    const s = await dailyRun(Policy.parse({ target: 15 }), { dry: false }, w.deps);
+    expect(s.target).toBe(DAILY.maxAwaitingApproval);
+    expect(w.ran.map((r) => r.id)).toEqual(["a"]);
+    expect(entries.filter(isPrepared)).toHaveLength(DAILY.maxAwaitingApproval);
+  });
+
+  it("sends with --send, whatever the policy says, and a rehearsal never prepares", async () => {
+    const w = world([job("a"), job("b", { ats: "lever" })]);
+    const s = await dailyRun(Policy.parse({}), { dry: false, target: 2, prepare: false }, w.deps);
+    expect(s.sent.map((l) => l.id)).toEqual(["a", "b"]);
+    expect(s.prepare).toBeUndefined();
+    const dry = world([job("c")]);
+    const r = await dailyRun(Policy.parse({}), { dry: true, target: 1 }, dry.deps);
+    expect(dry.ran).toEqual([{ id: "c", prepare: false }]);
+    expect(r.prepare).toBeUndefined();
+  });
+});
+
+describe("the daily run with \"mode\": \"send\"", () => {
+  it("sends as before, with minutes between two applications to one board", async () => {
+    const entries = [job("a"), job("b")];
+    const w = world(entries);
+    const s = await dailyRun(Policy.parse({ mode: "send" }), { dry: false, target: 2 }, w.deps);
+    expect(w.ran).toEqual([
+      { id: "a", prepare: false },
+      { id: "b", prepare: false },
+    ]);
+    expect(s.sent.map((l) => l.id)).toEqual(["a", "b"]);
+    expect(s.prepared).toBeUndefined();
+    expect(w.slept).toHaveLength(1);
+    expect(w.slept[0]).toBeGreaterThanOrEqual(DAILY.gapMs[0] - 30_000);
+    expect(entries.every((e) => e.status === "applied")).toBe(true);
+    expect(formatDaily(s)).toMatch(/^2 submitted\./);
+  });
+
+  it("prepares with --prepare, whatever the policy says", async () => {
+    const w = world([job("a")]);
+    const s = await dailyRun(Policy.parse({ mode: "send" }), { dry: false, target: 1, prepare: true }, w.deps);
+    expect(s.sent).toEqual([]);
+    expect(s.prepared?.map((l) => l.id)).toEqual(["a"]);
+  });
+});
diff --git a/tests/visaType.test.ts b/tests/visaType.test.ts
new file mode 100644
index 0000000..2838d32
--- /dev/null
+++ b/tests/visaType.test.ts
@@ -0,0 +1,90 @@
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { ProfileSchema, visaNamePattern, type Profile } from "../src/profile/schema.js";
+import { buildFormState, gateAnswer, planField } from "../src/forms/mapForm.js";
+import { buildSystem, candidateContext, contextFingerprint } from "../src/answers/resolve.js";
+import type { DumpedField, FieldsDump } from "../src/forms/fields.js";
+import type { Job } from "../src/jobs/normalize.js";
+
+const example = ProfileSchema.parse(JSON.parse(readFileSync(new URL("../data/profile.example.json", import.meta.url), "utf8")));
+const withVisa = (over: Partial<Profile["workAuthorization"]>): Profile => ({ ...example, workAuthorization: { ...example.workAuthorization, ...over } });
+/** Authorized in Canada, and in the US now on F-1 CPT, needing sponsorship later; never H-1B as the type. */
+const student = withVisa({ authorizedWithSponsorshipLater: ["United States"], visaType: "F-1 CPT", visaTypeNames: ["F-1", "CPT"], neverVisaTypes: ["H-1B"] });
+
+const job = { id: "j", source: "t", company: "Example Corp", title: "Software Engineer Intern", url: "https://jobs.example.com/1", ats: "greenhouse", locations: ["New York, NY"], postedAt: null, terms: [], sponsorship: "unknown", degrees: [], category: null } as Job;
+const field = (over: Partial<DumpedField>): DumpedField => ({ id: "f0", widget: "", selector: "#x", kind: "text", name: "", label: "", hint: "", placeholder: "", required: true, value: "", options: [], accept: "", maxLength: null, autocomplete: "", buttonGroup: false, section: "", ...over });
+const visaQ = field({ kind: "radio", label: "Which visa type do you hold?" });
+const dump = { url: "https://jobs.example.com/1/apply", title: "Apply", context: "", fields: [] } as unknown as FieldsDump;
+
+describe("visa names", () => {
+  it("match as whole words, with or without hyphens and spaces", () => {
+    const re = visaNamePattern(["H-1B"]);
+    for (const v of ["H1B", "h-1b", "H 1B", "an H-1B visa"]) expect(re?.test(v), v).toBe(true);
+    for (const v of ["H-1B1", "BH1B", "H-2B"]) expect(re?.test(v), v).toBe(false);
+    expect(visaNamePattern(["F-1 CPT"])?.test("F1 CPT")).toBe(true);
+    expect(visaNamePattern(["CPT"])?.test("acceptable")).toBe(false);
+    expect(visaNamePattern([])).toBeNull();
+    expect(visaNamePattern(["  "])).toBeNull();
+  });
+});
+
+describe("the visa type gate", () => {
+  it("refuses a type the profile never gives, unless the answer names the candidate's own", () => {
+    for (const v of ["H1B", "H-1B", "H-1B visa"]) expect(gateAnswer(visaQ, v, student, job), v).toMatch(/never gives/);
+    expect(gateAnswer(visaQ, "F1", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "CPT", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "F-1 CPT, then H-1B later", student, job)).toBeNull();
+    expect(gateAnswer(visaQ, "TN", student, job)).toBeNull();
+  });
+
+  it("leaves a plain Yes or No to the right-to-work gate", () => {
+    const sponsorQ = field({ kind: "radio", label: "Will you now or in the future require H-1B sponsorship?" });
+    expect(gateAnswer(sponsorQ, "Yes, H-1B", student, job)).toBeNull();
+    expect(gateAnswer(sponsorQ, "No", student, job)).toMatch(/does not match the profile/);
+  });
+
+  it("holds a picked option that names a forbidden type for the candidate", () => {
+    const options = [{ value: "a", label: "H-1B" }, { value: "b", label: "F-1 (CPT/OPT)" }];
+    const f = field({ kind: "select", label: "Which visa type do you hold?", options });
+    const pick = (choice: string) => ({ type: "choice", choice, confidence: 0.99, probabilities: {} }) as never;
+    expect(planField(f, pick("o0"), student, job)).toMatchObject({ action: "review", note: expect.stringMatching(/never gives/) });
+    expect(planField(f, pick("o1"), student, job).value).toBe("b");
+  });
+
+  it("refuses nothing new when the profile names no type", () => {
+    for (const v of ["H1B", "H-1B visa", "F1"]) expect(gateAnswer(visaQ, v, example, job), v).toBeNull();
+  });
+});
+
+describe("the writer's visa lines", () => {
+  const rulesOf = (p: Profile) => (buildFormState(p, job, dump, []).candidate as { rules: string[] }).rules;
+
+  it("are in the form state and the writer's context only when a visa type is set", () => {
+    expect(rulesOf(example).join(" ")).not.toMatch(/visa type/i);
+    expect(candidateContext(example)).not.toHaveProperty("visa_rules");
+    expect(buildSystem(example)).not.toMatch(/visa_rules/);
+
+    const rules = rulesOf(student).join("\n");
+    expect(rules).toMatch(/In United States the candidate is currently authorized to work, through F-1 CPT, so a question whether they are currently authorized to work there is Yes/);
+    expect(rules).toMatch(/The visa type is F-1 CPT\. Never choose or write H-1B as the type\. If no option names F-1 CPT or F-1 or CPT, leave the field for the candidate/);
+    const visa = candidateContext(student).visa_rules as string[];
+    expect(visa.join("\n")).toMatch(/currently authorized to work, through F-1 CPT/);
+    expect(visa.join("\n")).toMatch(/set verdict to "needs_review"/);
+  });
+
+  it("leave the writer's context as before when the visa fields are empty", () => {
+    const blank = withVisa({ visaType: "", visaTypeNames: [], neverVisaTypes: [] });
+    expect(candidateContext(blank)).not.toHaveProperty("visa_rules");
+    expect(rulesOf(blank)).toEqual(rulesOf(example));
+    const { visaType: _a, visaTypeNames: _b, neverVisaTypes: _c, ...older } = example.workAuthorization;
+    const before = { ...example, workAuthorization: older };
+    expect(rulesOf(before)).toEqual(rulesOf(example));
+    expect(contextFingerprint(before)).not.toBe(contextFingerprint(student));
+  });
+
+  it("say nothing about current authorization without a country that needs sponsorship later", () => {
+    const rules = rulesOf(withVisa({ visaType: "TN" })).join("\n");
+    expect(rules).toMatch(/The visa type is TN\. If no option names TN, leave the field/);
+    expect(rules).not.toMatch(/currently authorized/);
+  });
+});
