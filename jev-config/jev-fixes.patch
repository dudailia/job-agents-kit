+  const ships = (v: string) => /example|voice/.test(p.basename(v));
+  const moved = (v: string) => (v.startsWith(p.join(real.ROOT, "data")) || v.startsWith(p.join(real.ROOT, "applications"))) && !ships(v);
+  const PATHS = Object.fromEntries(Object.entries(real.PATHS).map(([k, v]) => [k, typeof v === "string" && moved(v) ? p.join(dir, p.relative(real.ROOT, v)) : v])) as typeof real.PATHS;
+  return { ...real, PATHS, RUN: { ...real.RUN, fillConcurrency: 1, hostGapMs: 0, fillAttempts: 1, submitGapMs: 0, employerGapMs: 0 } };
+});
+vi.mock("../src/jev/client.js", async (importOriginal) => ({ ...(await importOriginal<object>()), JevClient: class {} }));
+vi.mock("../src/browser/cdp.js", async (importOriginal) => ({ ...(await importOriginal<object>()), ensureBrowser: vi.fn(async () => undefined) }));
